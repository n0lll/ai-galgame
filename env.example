# ============================================
# 无限流异世界恋爱 Visual Novel - 环境配置
# ============================================
# 使用说明：将此文件复制为 .env 并填入真实的配置值

# -------------------- API 配置 --------------------

# OpenAI 兼容 API 密钥（必填）
# 从 SiliconFlow 获取: https://cloud.siliconflow.cn
OPENAI_API_KEY=your_api_key_here

# API 基础 URL（默认使用 SiliconFlow）
OPENAI_BASE_URL=https://api.siliconflow.cn/v1

# DeepSeek 对话模型
DEEPSEEK_MODEL=deepseek-ai/DeepSeek-V3

# Flux 图像生成模型
FLUX_MODEL=black-forest-labs/FLUX.1-schnell

# API 请求超时时间（秒）
API_TIMEOUT=60

# API 请求最大重试次数
API_MAX_RETRIES=3


# -------------------- 应用配置 --------------------

# 应用名称
APP_NAME=无限流异世界恋爱 Visual Novel

# 应用版本
APP_VERSION=0.1.0

# 数据存储目录
DATA_DIR=data

# 缓存目录
CACHE_DIR=cache

# 资源文件目录
ASSETS_DIR=assets


# -------------------- 游戏配置 --------------------

# 最大存档槽位数
MAX_SAVE_SLOTS=10

# 自动保存间隔（回合数）
AUTO_SAVE_INTERVAL=5


# -------------------- 图像生成配置 --------------------

# 生成图像宽度
IMAGE_WIDTH=512

# 生成图像高度
IMAGE_HEIGHT=768

# 是否启用图像缓存
IMAGE_CACHE_ENABLED=true


# -------------------- 调试配置 --------------------

# 调试模式（true/false）
DEBUG_MODE=false




